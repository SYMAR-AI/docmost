# ============================================================================
# DOCMOST ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in the values for your deployment.
# Lines starting with # are comments and will be ignored.
# ============================================================================

# ============================================================================
# CORE APPLICATION
# ============================================================================
# The public URL where your Docmost instance is accessible
APP_URL=http://localhost:3000

# Secret key for encrypting sensitive data. Required.
# Generate a secure value with: openssl rand -hex 32
APP_SECRET=

# HTTP server port
PORT=3000

# Application environment
# Options: development, production, test
NODE_ENV=production

# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL connection string with pgvector support (pgvector/pgvector:pg16)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://docmost:docmost@localhost:5432/docmost

# Maximum connection pool size for database connections
DATABASE_MAX_POOL=10

# ============================================================================
# REDIS
# ============================================================================
# Redis connection URL for caching and real-time collaboration
REDIS_URL=redis://localhost:6379

# ============================================================================
# SEARCH ENGINE (TYPESENSE)
# ============================================================================
# Search driver to use for document indexing and full-text search
# Options: database (default), typesense
# Use 'database' for basic search via PostgreSQL
# Use 'typesense' for advanced full-text search and faceting
SEARCH_DRIVER=database

# Typesense server URL (required when SEARCH_DRIVER=typesense)
TYPESENSE_URL=http://localhost:8108

# Typesense API key for authentication (required when SEARCH_DRIVER=typesense)
TYPESENSE_API_KEY=

# Language locale for Typesense search tokenization (default: en)
# Set to 'cs' for Czech language support
TYPESENSE_LOCALE=cs

# ============================================================================
# AI / EMBEDDINGS (AZURE OPENAI)
# ============================================================================
# Azure OpenAI endpoint for embeddings and semantic search
# Format: https://<resource-name>.openai.azure.com/
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://your-instance.openai.azure.com

# Azure OpenAI API key for authentication
AZURE_OPENAI_EMBEDDING_API_KEY=

# Azure OpenAI deployment name for embeddings model
# Default: text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Azure OpenAI API version
# Default: 2024-06-01
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-06-01

# Dimension of embedding vectors (must match the deployment model)
# text-embedding-3-small: 1536
# text-embedding-3-large: 3072
AZURE_OPENAI_EMBEDDING_DIMS=3072

# ============================================================================
# AI / EMBEDDINGS (OPENAI)
# ============================================================================
# OpenAI API key (required when AI_DRIVER=openai)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional custom OpenAI API URL for Azure OpenAI or other providers
# Default: https://api.openai.com/v1
OPENAI_API_URL=

# ============================================================================
# AI / EMBEDDINGS (OLLAMA)
# ============================================================================
# Ollama API URL (required when AI_DRIVER=ollama)
# Local Ollama instance typically runs on this port
OLLAMA_API_URL=http://localhost:11434

# ============================================================================
# FILE STORAGE
# ============================================================================
# Storage driver for file uploads and imports
# Options: local (default), s3
STORAGE_DRIVER=local

# Maximum file size for single file uploads
# Format: number with unit (b, kb, mb, gb)
FILE_UPLOAD_SIZE_LIMIT=50mb

# Maximum file size for bulk imports
# Format: number with unit (b, kb, mb, gb)
FILE_IMPORT_SIZE_LIMIT=200mb

# ============================================================================
# AWS S3 STORAGE (when STORAGE_DRIVER=s3)
# ============================================================================
# AWS S3 access key ID
AWS_S3_ACCESS_KEY_ID=

# AWS S3 secret access key
AWS_S3_SECRET_ACCESS_KEY=

# AWS region where the S3 bucket is located
# Example: us-east-1, eu-west-1
AWS_S3_REGION=

# S3 bucket name for storing files
AWS_S3_BUCKET=

# Custom S3 endpoint (for S3-compatible providers like MinIO)
# Leave empty for standard AWS S3
AWS_S3_ENDPOINT=

# Force path-style URLs instead of virtual-hosted-style
# Set to true for S3-compatible providers that don't support virtual-hosted-style
AWS_S3_FORCE_PATH_STYLE=false

# Public URL for accessing S3 files (optional)
# Used for file download links
AWS_S3_URL=

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
# Email delivery driver
# Options: log (default - outputs to console), smtp, postmark
MAIL_DRIVER=log

# Sender email address for outgoing emails
# Example: noreply@docmost.com
MAIL_FROM_ADDRESS=

# Sender name for outgoing emails
# Displayed as "from" name in email clients
MAIL_FROM_NAME=Docmost

# ============================================================================
# SMTP CONFIGURATION (when MAIL_DRIVER=smtp)
# ============================================================================
# SMTP server hostname
SMTP_HOST=

# SMTP server port
# Standard: 25 (unencrypted), 587 (TLS), 465 (SSL)
SMTP_PORT=587

# Use TLS encryption for SMTP connection (true/false)
SMTP_SECURE=false

# Ignore TLS certificate verification errors
# Only use true for testing/development
SMTP_IGNORETLS=false

# SMTP authentication username
SMTP_USERNAME=

# SMTP authentication password
SMTP_PASSWORD=

# ============================================================================
# POSTMARK CONFIGURATION (when MAIL_DRIVER=postmark)
# ============================================================================
# Postmark API token for sending emails
# Get from: https://account.postmarkapp.com/api_tokens
POSTMARK_TOKEN=

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# JWT token expiration time
# Format: number with unit (s, m, h, d)
# Default: 90d (90 days)
JWT_TOKEN_EXPIRES_IN=90d

# ============================================================================
# COLLABORATION & REAL-TIME FEATURES
# ============================================================================
# External collaboration server URL (optional)
# Leave empty to use default embedded collaboration
COLLAB_URL=

# Disable Redis for collaboration features
# Set to false (default) to enable Redis-based collaboration
# Set to true only if Redis is unavailable (degrades real-time performance)
COLLAB_DISABLE_REDIS=false

# ============================================================================
# TELEMETRY & ANALYTICS
# ============================================================================
# Disable telemetry and analytics collection
# Set to true to opt-out of telemetry (default: false)
DISABLE_TELEMETRY=false

# ============================================================================
# DRAW.IO INTEGRATION
# ============================================================================
# Optional external Draw.io server URL for diagram embedding
# Leave empty to use default online Draw.io (draw.io)
# Use custom URL to self-host Draw.io or use different version
DRAWIO_URL=

# ============================================================================
# DOCKER COMPOSE VARIABLES
# ============================================================================
# The following variables are used specifically in docker-compose.yml
# and define the containerized deployment environment.
#
# Application settings for Docker deployment
DOCMOST_APP_URL=http://localhost:3000
DOCMOST_APP_SECRET=

# Database password for PostgreSQL container
DOCMOST_DB_PASSWORD=docmost

# Application port exposed by Docker container
DOCMOST_PORT=3000

# Typesense port exposed by Docker container
TYPESENSE_PORT=8108
